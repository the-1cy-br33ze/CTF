<!DOCTYPE html>
<html>
<head>
  <title><%= theme === 'retro' ? 'Контакты' : 'Contact Us' %></title>
  <link rel="stylesheet" href="/<%= theme %>/style.css">
</head>
<body>
  <%- include('partials/header') %>
  
  <div class="content">
    <% if(theme === 'retro') { %>
      <h2>Как нас найти</h2>
      <p>Адрес: 197101, г. Санкт-Петербург, ул. Профессора Попова, 5</p>
      <p>Телефон: +7 (812) 234-56-78</p>
      <p>E-mail: <a href="mailto:info@oldportal.ru">info@oldportal.ru</a></p>
      
      <h3>Форма обратной связи:</h3>
      <form>
        <table>
          <tr>
            <td>Ваше имя:</td>
            <td><input type="text" size="30"></td>
          </tr>
          <tr>
            <td>E-mail:</td>
            <td><input type="text" size="30"></td>
          </tr>
          <tr>
            <td colspan="2">
              <textarea cols="50" rows="5"></textarea>
            </td>
          </tr>
          <tr>
            <td colspan="2">
              <input type="submit" value="Отправить" class="button">
            </td>
          </tr>
        </table>
      </form>
      
    <% } else { %>
      <h2>Свяжитесь с нами</h2>
      <div class="contact-info">
        <div class="contact-item">
          <h3>Адрес</h3>
          <p>Москва, Пресненская наб., 10</p>
        </div>
        <div class="contact-item">
          <h3>Контакты</h3>
          <p>Телефон: +7 (495) 123-45-67</p>
          <p>Email: contact@techfuture.ru</p>
        </div>
      </div>
      
      <h3>Онлайн-форма:</h3>
      <form class="modern-form">
        <input type="text" placeholder="Ваше имя">
        <input type="email" placeholder="E-mail">
        <textarea rows="4" placeholder="Сообщение"></textarea>
        <button type="submit">Отправить</button>
      </form>
    <% } %>
  </div>
</body>
</html>